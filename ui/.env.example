# Keycloak Ops Console — environment variables
# Copy this file to .env.local and adjust for your environment.

# Backend API base URL (no trailing slash)
VITE_API_BASE_URL=http://localhost:8081

# Auth mode: OPEN_LAB (no credentials required) or OIDC
VITE_AUTH_MODE=OPEN_LAB

# OIDC settings — only used when VITE_AUTH_MODE=OIDC
# VITE_OIDC_AUTHORITY=https://your-keycloak/realms/ops-console
# VITE_OIDC_CLIENT_ID=ops-console-ui
# VITE_OIDC_REDIRECT_URI=http://localhost:3000/callback
# VITE_OIDC_SCOPE=openid profile email

# Optional: default page size for lists
# VITE_DEFAULT_PAGE_SIZE=20
